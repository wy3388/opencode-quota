{
  "name": "@wy3366/opencode-quota",
  "version": "0.1.3",
  "description": "OpenCode TUI plugin that shows the active model provider's remaining quota in the sidebar",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node build.tui.mjs",
    "dev": "node build.tui.mjs --watch",
    "prepublishOnly": "npm run build",
    "release:patch": "npm version patch && git push --follow-tags"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.6",
    "@opencode/theme": "^2.2.6",
    "@opentui/core": "^0.8.3",
    "@opentui/solid": "^0.8.3",
    "@types/node": "^22.10.0",
    "babel-preset-solid": "^1.9.16",
    "esbuild": "^0.25.12",
    "esbuild-plugin-solid": "^0.5.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.0",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "quota",
    "balance",
    "ollama",
    "opencode-go"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wy3388/opencode-quota.git"
  },
  "bugs": {
    "url": "https://github.com/wy3388/opencode-quota/issues"
  },
  "homepage": "https://github.com/wy3388/opencode-quota#readme"
}
